{
  "exchange": {
    "name": "binance",
    "sandbox": true,
    "ccxt_config": {
      "enableRateLimit": true,
      "rateLimit": 1200
    }
  },
  "trading": {
    "pairs": [
      "BTC/USDT",
      "ETH/USDT",
      "BNB/USDT",
      "SOL/USDT"
    ],
    "timeframes": {
      "primary": "1h",
      "secondary": "15m"
    },
    "strategy": "ensemble",
    "max_open_trades": 3,
    "stake_amount": 0.05,
    "stake_currency": "USDT"
  },
  "runtime": {
    "deployment_profile": "paper_legacy",
    "runtime_mode": "legacy",
    "shadow_mode": false
  },
  "risk_management": {
    "max_position_size": 0.05,
    "max_daily_loss": 0.02,
    "stop_loss_percent": 0.02,
    "take_profit_percent": 0.04,
    "trailing_stop": true,
    "trailing_stop_positive": 0.01,
    "cooldown_candles": 5,
    "max_spread_percent": 0.5
  },
  "backtesting": {
    "timerange": "20230101-20231231",
    "initial_balance": 10000,
    "fee": 0.001
  },
  "strategy_config": {
    "min_signal_strength": 0.35,
    "rsi_oversold": 30,
    "rsi_overbought": 70,
    "stoch_oversold": 20,
    "stoch_overbought": 80,
    "adx_threshold": 25,
    "min_volume_ratio": 1.2
  },
  "freqai": {
    "enabled": true,
    "model": "LightGBMClassifier",
    "identifier": "akiba_freqai_model",
    "train_period": 200,
    "model_expiry_hours": 48,
    "include_timeframes": [
      "1h",
      "4h"
    ],
    "include_corr_pairs": [],
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42
    },
    "feature_parameters": {
      "include_timeframes": [
        "1h",
        "4h"
      ],
      "include_corr_pairs": []
    },
    "ml_params": {
      "lookahead_period": 5,
      "training_data_period": 1000
    }
  },
  "persistence": {
    "db_path": "data/trades.db"
  },
  "circuit_breaker": {
    "volatility_threshold": 3.0,
    "drawdown_threshold": 0.20
  },
  "notifications": {
    "telegram_enabled": true,
    "trade_notifications": true,
    "error_notifications": true,
    "daily_reports": true
  },
  "logging": {
    "level": "DEBUG",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/akiba_crypto_bot.log",
    "max_bytes": 10485760,
    "backup_count": 5
  }
}
